# Local development examples only; not production credentials.
POSTGRES_DB=smart_lost_found
POSTGRES_USER=smart_lost_found
POSTGRES_PASSWORD=local_dev_password
BACKEND_PORT=8000
# Compose always uses db:5432. These defaults also serve Alembic/local Python.
DB_HOST=db
DB_PORT=5432

# Business APIs are disabled by default. Enable only on a local loopback-bound server.
LOCAL_DEVELOPMENT=false
# Operator resolution: set both on the server; empty values disable admin APIs (503).
# Use ASCII credentials, a unique strong password and HTTPS outside localhost.
# Never put these in VITE_* variables or commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# The values below are examples for local tests, NOT agreed device/AI policies.
# COMMAND_TTL_SECONDS=30
# Return codes are refused entirely without this. Lifetime is a local choice, not an agreed policy.
# RETURN_CODE_TTL_SECONDS=600
# PI_TIMEOUT_SECONDS=10
# MAX_IMAGE_BYTES=10485760
# PREVIEW_TTL_SECONDS=60
# S3_BUCKET=your-private-bucket
# S3_REGION=ap-northeast-2
# PI_DEVICES={"00000000-0000-0000-0000-000000000001":{"capture_url":"http://capture-pi:8000","locker_url":"http://locker-pi:8000"}}
# Optional capture_api_key / locker_api_key keys belong inside each device entry.
# AWS credentials use boto3's normal environment/role credential chain.

# Device state and alerts over MQTT (docs/mqtt-protocol.md). An empty MQTT_HOST leaves the
# subscriber off and the API behaves exactly as before. In Compose the broker is the `mqtt`
# service; on a workstation point this at wherever Mosquitto runs. Keep the password out of Git.
# MQTT_HOST=mqtt
# MQTT_PORT=1883
# MQTT_USERNAME=backend
# MQTT_PASSWORD=
# One backend per client id: two subscribers sharing one id disconnect each other, and the
# broker's queue of alerts for the offline backend is tied to that id.
# MQTT_CLIENT_ID=slf-backend
# MQTT_ALERT_RETENTION_DAYS=14

# Gemini for two-photo registration analysis and ownership verification. Keep the key out of Git.
# GEMINI_MODEL is the model for two-photo registration analysis and standalone experiments.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=4096
# Photo analysis only; ownership text requests keep GEMINI_TIMEOUT_SECONDS.
IMAGE_ANALYSIS_TIMEOUT_SECONDS=90
