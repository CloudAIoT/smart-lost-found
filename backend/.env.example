# Local development examples only; not production credentials.
POSTGRES_DB=smart_lost_found
POSTGRES_USER=smart_lost_found
POSTGRES_PASSWORD=local_dev_password
BACKEND_PORT=8000
# Compose always uses db:5432. These defaults also serve Alembic/local Python.
DB_HOST=db
DB_PORT=5432

# Business APIs are disabled by default. Enable only on a local loopback-bound server.
LOCAL_DEVELOPMENT=false
# The values below are examples for local tests, NOT agreed device/AI policies.
# COMMAND_TTL_SECONDS=30
# PI_TIMEOUT_SECONDS=10
# MAX_IMAGE_BYTES=10485760
# PREVIEW_TTL_SECONDS=60
# S3_BUCKET=your-private-bucket
# S3_REGION=ap-northeast-2
# PI_DEVICES={"00000000-0000-0000-0000-000000000001":{"capture_url":"http://capture-pi:8000","locker_url":"http://locker-pi:8000"}}
# Optional capture_api_key / locker_api_key keys belong inside each device entry.
# AWS credentials use boto3's normal environment/role credential chain.
