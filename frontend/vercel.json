{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://52.78.12.168/api/:path*" },
    { "source": "/docs", "destination": "http://52.78.12.168/docs" },
    { "source": "/docs/:path*", "destination": "http://52.78.12.168/docs/:path*" },
    { "source": "/health", "destination": "http://52.78.12.168/health" },
    { "source": "/ready", "destination": "http://52.78.12.168/ready" },
    { "source": "/openapi.json", "destination": "http://52.78.12.168/openapi.json" },
    { "source": "/web", "destination": "/index.html" },
    { "source": "/web/:path*", "destination": "/index.html" },
    { "source": "/kiosk", "destination": "/index.html" },
    { "source": "/kiosk/:path*", "destination": "/index.html" },
    { "source": "/admin/devices", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
