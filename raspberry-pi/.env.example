# 예시 값이다. 실제 API 키는 저장소에 올리지 않는다.
# 역할: capture(촬영 Pi) 또는 locker(보관함 Pi)
PI_ROLE=capture
# 백엔드가 X-API-Key 헤더로 보내는 값과 같아야 한다 (8자 이상)
PI_API_KEY=change-me-please
# true면 실제 장치 대신 가짜 하드웨어로 동작한다 (개발·연동 시험용)
# false면 촬영 Pi는 실제 카메라, 보관함 Pi는 칸마다 LED와 버튼을 쓴다
PI_FAKE_HARDWARE=true
# 실제 카메라 사진 크기(가로, 세로)와 초점 맞추기 시간 제한(초)
PI_CAPTURE_WIDTH=2304
PI_CAPTURE_HEIGHT=1296
PI_FOCUS_TIMEOUT_SECONDS=3
# 보관함 Pi의 칸 수(가짜 모드). 보관함 번호는 1부터 센다
PI_LOCKER_COUNT=2
# 보관함 Pi: 칸마다 LED(잠금장치 대신)와 버튼(문 센서 대신)의 GPIO 번호. 1번 칸, 2번 칸 순서
PI_LOCKER_LED_PINS=[17,27]
PI_LOCKER_BUTTON_PINS=[22,23]
# 가짜 촬영에 걸리는 시간(초), 가짜 문이 열려 있다가 닫히기까지의 시간(초)
PI_FAKE_CAPTURE_SECONDS=1
PI_FAKE_DOOR_OPEN_SECONDS=5
# 가상 센서와 MQTT (결정 기록 0004, docs/mqtt-protocol.md)
# MQTT 토픽에 붙는 키오스크 ID. 백엔드의 키오스크 ID와 같아야 한다
PI_KIOSK_ID=00000000-0000-0000-0000-000000000001
# true면 시연용 /sim 경로가 열려 가상 센서 값을 바꿀 수 있다
PI_SIMULATION=false
# MQTT 브로커. 주소를 비우면 브로커에 보내지 않고 로그로만 남긴다. 비밀번호는 저장소에 올리지 않는다
PI_MQTT_HOST=
PI_MQTT_PORT=1883
PI_MQTT_USERNAME=
PI_MQTT_PASSWORD=
# 무게가 이 값(g)보다 무거우면 물건이 있다고 본다
PI_ITEM_THRESHOLD_G=10
# 문이 닫힌 뒤 무게를 읽기까지 기다리는 시간(초)
PI_DOOR_SETTLE_SECONDS=1
# 마지막 촬영 뒤 이 시간(초)이 지나도 촬영 상자에 물건이 있으면 경고한다
PI_CAPTURE_LEFTOVER_SECONDS=120
# 가상 센서 값을 저장할 파일. 비우면 저장하지 않는다
PI_SENSOR_STATE_FILE=
