# 예시 값이다. 실제 API 키는 저장소에 올리지 않는다.
# 역할: capture(촬영 Pi) 또는 locker(보관함 Pi)
PI_ROLE=capture
# 백엔드가 X-API-Key 헤더로 보내는 값과 같아야 한다 (8자 이상)
PI_API_KEY=change-me-please
# true면 실제 장치 대신 가짜 하드웨어로 동작한다 (개발·연동 시험용)
# 촬영 Pi는 false로 실제 카메라를 쓴다. 보관함 Pi의 실제 장치는 아직 없어서 true로 둔다
PI_FAKE_HARDWARE=true
# 실제 카메라 사진 크기(가로, 세로)와 초점 맞추기 시간 제한(초)
PI_CAPTURE_WIDTH=2304
PI_CAPTURE_HEIGHT=1296
PI_FOCUS_TIMEOUT_SECONDS=3
# 보관함 Pi의 칸 수. 보관함 번호는 1부터 센다
PI_LOCKER_COUNT=2
# 가짜 촬영에 걸리는 시간(초), 가짜 문이 열려 있다가 닫히기까지의 시간(초)
PI_FAKE_CAPTURE_SECONDS=1
PI_FAKE_DOOR_OPEN_SECONDS=5
